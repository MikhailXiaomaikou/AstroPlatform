{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/block-protected-paths.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/tsc-check.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/ruff-check.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/doc-drift-check.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/flag-defense-redline.py"
          }
        ]
      }
    ]
  }
}
