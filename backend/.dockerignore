# Keep the Docker build context lean: the local macOS venv (1.3 GB) and
# cobaya/CAMB data (packages/, 1.1 GB) must never be baked into images.
# Render is unaffected (its context is a fresh clone), this protects
# local `docker compose build`.
venv/
.venv/
packages/
cobaya_runs/
tmp/
tests/
**/__pycache__/
**/*.pyc
.pytest_cache/
*.png
# Never bake local secrets into an image (Dockerfile does COPY . .)
.env
