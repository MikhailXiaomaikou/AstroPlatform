# Development example. Production must supply stable secrets and durable
# PostgreSQL/Redis/object-storage services; see ../DEPLOYMENT.md.
ENV=dev
STANDARD_ASTRO_RELEASE=dev
# Arbitrary Python is disabled by default. Trusted single-user local opt-in
# only; never enable the legacy executors in hosted/multi-user production.
# To opt in locally, change the SANDBOX_BACKEND value below to subprocess.
DATABASE_URL=sqlite+aiosqlite:///../data/astro.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=
FERNET_KEY=
# Restore-safe deletion ledger. Local dev may leave the key blank and use the
# FERNET_KEY fallback; production requires an explicit key and stable id.
DELETION_TOMBSTONE_KEY=
DELETION_TOMBSTONE_KEY_ID=dev-current
DELETION_TOMBSTONE_VERIFICATION_KEYS={}
# Independent, durable paper-evidence signing key (minimum 32 bytes in production).
# Keep retired keys in the
# JSON keyring during rotation; a legacy pre-key-id JWT secret may also be kept
# there so existing schema-v1 evidence remains verifiable.
EVIDENCE_SIGNING_KEY=
EVIDENCE_SIGNING_KEY_ID=
EVIDENCE_VERIFICATION_KEYS={}
# Ed25519 task-envelope keys for the registered HTTPS science Worker. The API
# holds the private seed; control/science workers receive only the key id,
# current public key, and retained public keyring.
WORKER_TASK_SIGNING_PRIVATE_KEY=
WORKER_TASK_SIGNING_KEY_ID=
WORKER_TASK_SIGNING_PUBLIC_KEY=
WORKER_TASK_VERIFICATION_KEYS=
ADMIN_SECRET=

# Research artifacts: local for development/Compose, s3 for hosted production.
STORAGE_BACKEND=local
STORAGE_REQUIRE_INTEGRITY=false
LOCAL_STORAGE_DIR=../data/fits
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path

PIPELINE_MODE=celery
SCIENCE_EXECUTION_BACKEND=celery
ENABLE_TRANSIENT_ALERT_INGEST=false
CONNECTOR_CACHE_BACKEND=auto
SANDBOX_BACKEND=disabled
TRUSTED_PROXY_MODE=none
RATE_LIMIT_ENABLED=false
CORS_ORIGINS=http://localhost:5173

# P1 dark-launch and privacy controls. This is a development example, so local
# signup stays public. The target hosted alpha uses SIGNUP_MODE=invite_only.
SIGNUP_MODE=public
CLAIM_AUDIT_ENABLED=false
# v0.2 lightweight scalar routing/source receipts. Dark by default; disabling
# it restores the pre-v0.2 router and requires no database migration.
LIGHTWEIGHT_VERIFICATION_ENABLED=false
# Research/Foundry capabilities are dark by default and must be enabled in the
# documented order. The Candidate Catalog is never a formal evidence source.
RESEARCH_WORKSPACE_ENABLED=false
ARXIV_READER_ENABLED=false
UNION3_REPRODUCTION_ENABLED=false
EVIDENCE_PACK_V2_ENABLED=false
LOCAL_SCIENCE_WORKER_ENABLED=false
WORKFLOW_REGISTRY_V2_ENABLED=false
FOUNDRY_GAP_TRACKING_ENABLED=false
FOUNDRY_AI_DRAFTING_ENABLED=false
FOUNDRY_AUTO_DEMO_ENABLED=false
FOUNDRY_CANDIDATE_CATALOG_ENABLED=false
FOUNDRY_SOURCE_MATERIALIZATION_ENABLED=false
FOUNDRY_REGISTRATION_ENABLED=false
# Host-side Draft ingestion credential. The AI provider job must never receive
# this value. Keep it independent from inference, admin, Demo and signing keys.
FOUNDRY_DRAFT_RESULT_SECRET=
# The control plane sends only draft/candidate UUIDs, the gap fingerprint/code,
# generation route, and risk level to this pinned workflow. Use a fine-grained
# token limited to Actions:write on this repository.
FOUNDRY_DRAFT_DISPATCH_BACKEND=disabled
FOUNDRY_DRAFT_GITHUB_TOKEN=
FOUNDRY_DRAFT_GITHUB_REPOSITORY=
FOUNDRY_DRAFT_GITHUB_WORKFLOW=foundry-candidate-draft.yml
FOUNDRY_DRAFT_GITHUB_REF=main
# Narrow result-ingestion credential for an isolated Validation Runner. Never
# reuse an AI, login, admin, Worker, Evidence, or Registry credential.
FOUNDRY_VALIDATION_RESULT_SECRET=
FOUNDRY_VALIDATION_DISPATCH_BACKEND=disabled
FOUNDRY_VALIDATION_GITHUB_TOKEN=
FOUNDRY_VALIDATION_GITHUB_REPOSITORY=
FOUNDRY_VALIDATION_GITHUB_WORKFLOW=foundry-candidate-demo.yml
# workflow_dispatch accepts a branch/tag. Protect main and restrict the
# workflow's GitHub Environment to main; each run records the exact GITHUB_SHA.
FOUNDRY_VALIDATION_GITHUB_REF=main

# Protected source materialization (private signing key stays only in GitHub Environment)
FOUNDRY_MATERIALIZATION_RESULT_SECRET=
FOUNDRY_MATERIALIZATION_ATTESTATION_VERIFICATION_KEYS=
FOUNDRY_MATERIALIZATION_DISPATCH_BACKEND=disabled
FOUNDRY_MATERIALIZATION_GITHUB_TOKEN=
FOUNDRY_MATERIALIZATION_GITHUB_REPOSITORY=
FOUNDRY_MATERIALIZATION_GITHUB_WORKFLOW=foundry-materialize-candidate.yml
FOUNDRY_MATERIALIZATION_FINALIZE_GITHUB_WORKFLOW=foundry-finalize-materialization.yml
FOUNDRY_MATERIALIZATION_GITHUB_REF=main
# Dedicated success/failure callback credentials for protected formal-build and
# offline signed Registry receipts. They are mutually independent and are never
# signing keys. The failure secret belongs only to the automatic main-only
# foundry-formal-worker-failure Environment.
FOUNDRY_FORMAL_BUILD_RESULT_SECRET=
FOUNDRY_FORMAL_BUILD_FAILURE_RESULT_SECRET=
FOUNDRY_FORMAL_BUILD_OIDC_SUBJECT=
# JSON: {"formal-build-key-2026-01":"<base64 raw 32-byte Ed25519 public key>"}
# The matching private key exists only in the protected GitHub Environment;
# never put private formal-build key material in Render or this file.
FOUNDRY_FORMAL_BUILD_ATTESTATION_VERIFICATION_KEYS=
# The API reconstructs all five protected-build inputs from the immutable
# candidate version. Browser-supplied commit/tree values are never accepted.
FOUNDRY_FORMAL_BUILD_DISPATCH_BACKEND=disabled
FOUNDRY_FORMAL_BUILD_GITHUB_TOKEN=
FOUNDRY_FORMAL_BUILD_GITHUB_REPOSITORY=
FOUNDRY_FORMAL_BUILD_GITHUB_WORKFLOW=foundry-formal-worker.yml
FOUNDRY_FORMAL_BUILD_GITHUB_REF=main
FOUNDRY_REGISTRY_EXPORT_SECRET=
FOUNDRY_REGISTRY_IMPORT_RESULT_SECRET=
FOUNDRY_REGISTRY_ACTIVATION_RESULT_SECRET=
FOUNDRY_REGISTRY_DISPATCH_BACKEND=disabled
FOUNDRY_REGISTRY_GITHUB_TOKEN=
FOUNDRY_REGISTRY_GITHUB_REPOSITORY=
FOUNDRY_REGISTRY_GITHUB_WORKFLOW=foundry-registry-release.yml
FOUNDRY_REGISTRY_GITHUB_REF=main
# Only public Registry trust roots belong in the API/control plane. The
# signing seed is supplied solely to a protected offline release job.
WORKFLOW_REGISTRY_SIGNING_KEY_ID=
WORKFLOW_REGISTRY_SIGNING_PUBLIC_KEY=
WORKFLOW_REGISTRY_VERIFICATION_KEYS=
# A signed import is not activated in a running process. On the next explicit
# deployment, place the exact signed snapshot and one trusted public keyring at
# these fixed paths before enabling WORKFLOW_REGISTRY_V2_ENABLED.
WORKFLOW_REGISTRY_RELEASE_PATH=
WORKFLOW_REGISTRY_TRUSTED_KEYRING_JSON=
WORKFLOW_REGISTRY_TRUSTED_KEYRING_PATH=
WORKFLOW_REGISTRY_ACTIVATION_MANIFEST_PATH=
CLAIM_AUDIT_EXECUTION_MODE=celery
CLAIM_AUDIT_REGISTERED_TIMEOUT_SECONDS=1800
CLAIM_AUDIT_WORKER_LEASE_SECONDS=120
CLAIM_AUDIT_HEARTBEAT_SECONDS=30
CLAIM_AUDIT_MAX_ACTIVE_PER_USER=2
# Comma-separated account usernames permitted to append scientific reviews.
# A final SUPPORTED review must come from someone other than the Audit owner.
SCIENTIFIC_REVIEWER_USERNAMES=
ARTIFACT_CLEANUP_GRACE_SECONDS=86400
PRODUCT_ANALYTICS_RETENTION_DAYS=30
# Every production process requires the real operator, contact, and
# jurisdiction. They are public notice fields, not legal approval.
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT=
PRIVACY_JURISDICTION=

# Optional server-funded providers. Users may instead save BYOK credentials in
# the encrypted account settings API.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
PLATFORM_DEEPSEEK_API_KEY=
SHARED_DEEPSEEK_API_KEY_ENABLED=false
ADS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local-only: reuse an installed Codex/OpenAI CLI login. Never enable this on a
# hosted multi-user deployment.
# Subscription-CLI chat backends (local self-hosting; no API key needed when
# the CLI is installed and logged in on this machine).
CLAUDE_CLI_ENABLED=0
CLAUDE_CLI_COMMAND=claude
CLAUDE_CLI_MODEL=
OPENAI_CLI_ENABLED=0
OPENAI_CLI_COMMAND=codex
OPENAI_CLI_MODEL=
OPENAI_CLI_IGNORE_USER_CONFIG=1
OPENAI_CLI_IGNORE_RULES=1

# Local-only Bot Console: a self-hoster's own status/report/trigger dashboard
# for a personal weekly research-automation pipeline (outside this repo) plus
# a chat window pinned to one local model. Loopback-only, disabled in
# production, and inert unless configured. These are read from the process
# environment at request time, NOT from this file — pass them on the launch
# command line (mirroring the subscription-CLI pattern above), e.g.:
#   BOT_CONSOLE_MODEL_ID=my-local-model \
#   COSMO_SECOND_ORDER_ROOT=$HOME/my-pipeline \
#   RESEARCH_LAUNCHD_LABEL=com.example.research-weekly \
#   BOT_LAUNCHD_LABEL=com.example.notify-bot \
#   uvicorn app.main:app --reload --port 8000
# Optional: BOT_CONSOLE_ENABLED=0 (kill switch),
# RESEARCH_SCHEDULE_PRIMARY / RESEARCH_SCHEDULE_RECOVERY (display strings),
# LOCAL_CONTROL_ORIGINS (defaults to the local dev frontend origins).
