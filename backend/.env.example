# Development example. Production must supply stable secrets and durable
# PostgreSQL/Redis/object-storage services; see ../DEPLOYMENT.md.
ENV=dev
# Arbitrary Python is disabled by default. Trusted single-user local opt-in
# only; never enable the legacy executors in hosted/multi-user production.
# To opt in locally, change the SANDBOX_BACKEND value below to subprocess.
DATABASE_URL=sqlite+aiosqlite:///../data/astro.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=
FERNET_KEY=
# Optional independent HMAC key for restore-safe account-deletion tombstones.
# If blank, the code uses FERNET_KEY. Production must keep the chosen value
# stable across backend/worker restores and key rotations.
DELETION_TOMBSTONE_KEY=
# Independent, durable paper-evidence signing key (minimum 32 bytes in production).
# Keep retired keys in the
# JSON keyring during rotation; a legacy pre-key-id JWT secret may also be kept
# there so existing schema-v1 evidence remains verifiable.
EVIDENCE_SIGNING_KEY=
EVIDENCE_SIGNING_KEY_ID=
EVIDENCE_VERIFICATION_KEYS={}
ADMIN_SECRET=

# Research artifacts: local for development/Compose, s3 for hosted production.
STORAGE_BACKEND=local
STORAGE_REQUIRE_INTEGRITY=false
LOCAL_STORAGE_DIR=../data/fits
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path

PIPELINE_MODE=celery
ENABLE_TRANSIENT_ALERT_INGEST=false
CONNECTOR_CACHE_BACKEND=auto
SANDBOX_BACKEND=disabled
TRUSTED_PROXY_MODE=none
RATE_LIMIT_ENABLED=false
CORS_ORIGINS=http://localhost:5173

# P1 dark-launch and privacy controls. This is a development example, so local
# signup stays public. The target hosted alpha uses SIGNUP_MODE=invite_only.
SIGNUP_MODE=public
CLAIM_AUDIT_ENABLED=false
CLAIM_AUDIT_EXECUTION_MODE=celery
CLAIM_AUDIT_REGISTERED_TIMEOUT_SECONDS=1800
PRODUCT_ANALYTICS_RETENTION_DAYS=30
# Fill these with the real operator, contact, and jurisdiction before enabling
# Claim Audit in production. They are descriptive fields, not legal approval.
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT=
PRIVACY_JURISDICTION=

# Optional server-funded providers. Users may instead save BYOK credentials in
# the encrypted account settings API.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
PLATFORM_DEEPSEEK_API_KEY=
SHARED_DEEPSEEK_API_KEY_ENABLED=false
ADS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local-only: reuse an installed Codex/OpenAI CLI login. Never enable this on a
# hosted multi-user deployment.
# Subscription-CLI chat backends (local self-hosting; no API key needed when
# the CLI is installed and logged in on this machine).
CLAUDE_CLI_ENABLED=0
CLAUDE_CLI_COMMAND=claude
CLAUDE_CLI_MODEL=
OPENAI_CLI_ENABLED=0
OPENAI_CLI_COMMAND=codex
OPENAI_CLI_MODEL=
OPENAI_CLI_IGNORE_USER_CONFIG=1
OPENAI_CLI_IGNORE_RULES=1

# Local-only Bot Console: a self-hoster's own status/report/trigger dashboard
# for a personal weekly research-automation pipeline (outside this repo) plus
# a chat window pinned to one local model. Loopback-only, disabled in
# production, and inert unless configured. These are read from the process
# environment at request time, NOT from this file — pass them on the launch
# command line (mirroring the subscription-CLI pattern above), e.g.:
#   BOT_CONSOLE_MODEL_ID=my-local-model \
#   COSMO_SECOND_ORDER_ROOT=$HOME/my-pipeline \
#   RESEARCH_LAUNCHD_LABEL=com.example.research-weekly \
#   BOT_LAUNCHD_LABEL=com.example.notify-bot \
#   uvicorn app.main:app --reload --port 8000
# Optional: BOT_CONSOLE_ENABLED=0 (kill switch),
# RESEARCH_SCHEDULE_PRIMARY / RESEARCH_SCHEDULE_RECOVERY (display strings),
# LOCAL_CONTROL_ORIGINS (defaults to the local dev frontend origins).
